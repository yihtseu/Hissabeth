{
    "name": "hissabeth",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun run build:agent && vite",
        "build": "vue-tsc --noEmit && vite build && bun run build:agent",
        "preview": "vite preview",
        "tauri": "tauri",
        "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p src-tauri/tests/tsconfig.json --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "setup:chatgpt": "bun scripts/setup-chatgpt.mjs",
        "build:agent": "bun build scripts/agent-bridge.ts --target=node --outfile=dist/agent-bridge.mjs"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.330",
        "@openai/codex-sdk": "^0.171.0",
        "@tauri-apps/api": "^2.12.5",
        "@tauri-apps/plugin-dialog": "^2.8.4",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-log": "^2.10.2",
        "@tauri-apps/plugin-opener": "^2.7.3",
        "@tauri-apps/plugin-store": "^2.5.1",
        "@vueuse/core": "^15.1.0",
        "d3-scale": "^4.0.3",
        "d3-scale-chromatic": "^3.1.1",
        "d3-selection": "^3.0.1",
        "d3-zoom": "^3.0.1",
        "lucide-vue-next": "^1.0.0",
        "markstream-vue": "^2.0.30",
        "pinia": "^4.1.0",
        "reka-ui": "^2.11.0",
        "splitpanes": "^4.1.2",
        "uplot": "^1.6.32",
        "vue": "^3.5.46",
        "vue-i18n": "^11.4.23",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tauri-apps/cli": "^2.12.6",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-scale-chromatic": "^3.1.0",
        "@types/d3-selection": "^3.0.12",
        "@types/d3-zoom": "^3.0.9",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/test-utils": "^2.6.0",
        "jsdom": "^31.0.1",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1",
        "vue-tsc": "^3.3.14"
    }
}
