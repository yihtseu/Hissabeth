{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "lf",
    "ignorePatterns": ["dist/**", "src-tauri/**", "reference/**", "src/styles.css"]
}
